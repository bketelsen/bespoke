# Systemd USER unit for selfie: ~/.config/systemd/user/bespoke-hello.service

[Unit]
Description=Bespoke app: hello
After=network-online.target

[Service]
EnvironmentFile=%h/bespoke/env
ExecStart=%h/bespoke/bin/hello -listen ${BESPOKE_BIND_IP}:4101
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
