# Systemd USER unit for selfie: ~/.config/systemd/user/bespoke-platformd.service
# Requires: loginctl enable-linger <user>   (so units run without a session)
# Reads ~/bespoke/env for BESPOKE_BIND_IP and BESPOKE_DOMAIN (see deploy/README.md).

[Unit]
Description=Bespoke platformd (dashboard/registry)
After=network-online.target

[Service]
EnvironmentFile=%h/bespoke/env
Environment=BESPOKE_ROOT=%h/bespoke
ExecStart=%h/bespoke/bin/platformd -listen ${BESPOKE_BIND_IP}:4000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
