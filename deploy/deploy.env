# Deployment configuration for scripts/deploy.sh — EDIT THESE.
# No secrets belong here (the Cloudflare token lives only on the edge host).

# The apps domain (ADR-0003). Apps live at <slug>.$DOMAIN, dashboard at $DOMAIN.
DOMAIN=bespoke.ketelsen.cloud

# App host (ADR-0011): ssh destination and its tailscale IPv4 (`tailscale ip -4`).
SELFIE_SSH=bjk@<app-host-ip>
SELFIE_TS_IP=<app-host-tailscale-ip>

# Edge host running Caddy: ssh destination and where the route file lives.
# Its tailscale IPv4 is what the wildcard DNS records point at (runbook §2).
EDGE_SSH=you@your-caddy-host
EDGE_TS_IP=<edge-tailscale-ip>
EDGE_CADDY_FILE=/etc/caddy/bespoke.caddy

# selfie's architecture (uname -m: x86_64 → amd64, aarch64 → arm64).
GOARCH=amd64

# Edge host's architecture, for scripts/build-caddy.sh.
EDGE_GOARCH=amd64
