# Deployment configuration — copy to deploy/deploy.env (gitignored) and
# fill in YOUR values. No secrets belong here (the Cloudflare token lives
# only on the edge host), but the real file stays out of git anyway.

# The apps domain (ADR-0003). Apps live at <slug>.$DOMAIN, dashboard at $DOMAIN.
DOMAIN=bespoke.example.com

# App host (ADR-0011): ssh destination and its tailscale IPv4 (`tailscale ip -4`).
SELFIE_SSH=you@your-app-host
SELFIE_TS_IP=100.0.0.1

# Edge host running Caddy: ssh destination and where the route file lives.
# Its tailscale IPv4 is what the wildcard DNS records point at (runbook §2).
EDGE_SSH=you@your-caddy-host
EDGE_TS_IP=100.0.0.2
EDGE_CADDY_FILE=/etc/caddy/bespoke.caddy

# Architectures (uname -m: x86_64 → amd64, aarch64 → arm64).
GOARCH=amd64
EDGE_GOARCH=amd64
