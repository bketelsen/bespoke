package views

import (
	"github.com/bketelsen/bespoke/internal/manifest"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/alert"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
)

templ Dashboard(user auth.User, dev bool, domain string, apps []manifest.App, cards map[string]string, warnings []string) {
	@ui.AppShell(ui.ShellProps{User: user}) {
		if len(apps) == 0 {
			<p class="text-muted-foreground">No apps yet.</p>
		}
		<div class="grid gap-4 sm:grid-cols-2">
			for _, app := range apps {
				@card.Card(card.Props{Class: "h-full"}) {
					@card.Header(card.HeaderProps{Class: "pb-3"}) {
						<a href={ appURL(dev, domain, app) } class="group flex items-center gap-3">
							<span class="rounded-md bg-primary/10 p-2 text-primary">
								@ui.AppIcon(app.Icon, "size-5")
							</span>
							@card.Title(card.TitleProps{Class: "group-hover:text-primary transition-colors"}) {
								{ app.Name }
							}
						</a>
					}
					@card.Content(card.ContentProps{Class: "pt-0"}) {
						// App-provided live card (ADR-0017), else the manifest
						// description. Fragments come from our own apps over the
						// authenticated plane — trusted HTML.
						if frag, ok := cards[app.Slug]; ok {
							@templ.Raw(frag)
						} else {
							<p class="text-sm text-muted-foreground">{ app.Description }</p>
						}
					}
				}
			}
		</div>
		<p class="mt-8 text-center">
			<a href="/settings" class="text-sm text-muted-foreground transition-colors hover:text-primary">Your brief — what every AI here knows about you →</a>
		</p>
		for _, w := range warnings {
			<div class="mt-4">
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@icon.TriangleAlert(icon.Props{Class: "size-4"})
					@alert.Title() {
						Manifest problem
					}
					@alert.Description() {
						{ w }
					}
				}
			</div>
		}
	}
}
