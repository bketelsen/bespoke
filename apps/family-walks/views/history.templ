package views

import (
	"fmt"

	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
)

templ History(user auth.User, days []Day) {
	@ui.AppShell(ui.ShellProps{Title: "Family Walks — History", User: user}) {
		<div class="flex items-center justify-between">
			<h1 class="text-lg font-semibold">History</h1>
			@button.Button(button.Props{Href: "/", Variant: button.VariantGhost, Size: button.SizeSm}) {
				Today
			}
		</div>
		if len(days) == 0 {
			<p class="mt-6 text-muted-foreground">No walks logged yet.</p>
		} else {
			<div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
				for _, d := range days {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/history/%s", d.Date)) }
						class="flex items-center justify-between rounded-lg border bg-card px-4 py-3 hover:bg-accent"
					>
						<span class="text-sm font-medium">{ d.Date }</span>
						<span class="flex items-center gap-2">
							if d.Walked {
								<span class="text-sm text-primary">Walked 🚶</span>
							} else {
								<span class="text-sm text-destructive">No walk</span>
							}
						</span>
					</a>
				}
			</div>
		}
	}
}
