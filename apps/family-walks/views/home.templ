package views

import (
	"fmt"

	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
)

// Day is a single WalkDay record for display.
type Day struct {
	Date   string // YYYY-MM-DD
	Walked bool
	Logged bool
	Note   string
}

templ Home(user auth.User, today string, walked bool, logged bool, streak int, milestone string) {
	@ui.AppShell(ui.ShellProps{Title: "Family Walks", User: user}) {
		<div class="flex items-center justify-between">
			<h1 class="text-lg font-semibold">Family Walks</h1>
			@button.Button(button.Props{Href: "/history", Variant: button.VariantGhost, Size: button.SizeSm}) {
				History
			}
		</div>
		<div data-init="@get('/_live')" class="mt-4">
			@TodayLive(today, walked, logged, streak, milestone)
		</div>
	}
}

// TodayLive is the live region (ADR-0022): patched on any change to
// today's walk status or streak.
templ TodayLive(today string, walked bool, logged bool, streak int, milestone string) {
	<div id="family-walks-live" class="space-y-4">
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Did the family walk tonight?
				}
				@card.Description() {
					{ today }
				}
			}
			@card.Content(card.ContentProps{Class: "space-y-4"}) {
				<form method="post" action="/today" class="flex gap-3">
					<button
						type="submit"
						name="walked"
						value="yes"
						class={
							"flex-1 rounded-md border px-4 py-3 text-sm font-medium pointer-coarse:py-4",
							templ.KV("bg-primary text-primary-foreground border-primary", logged && walked),
							templ.KV("bg-transparent text-foreground", !(logged && walked)),
						}
					>
						Yes 🚶
					</button>
					<button
						type="submit"
						name="walked"
						value="no"
						class={
							"flex-1 rounded-md border px-4 py-3 text-sm font-medium pointer-coarse:py-4",
							templ.KV("bg-destructive text-destructive-foreground border-destructive", logged && !walked),
							templ.KV("bg-transparent text-foreground", !(logged && !walked)),
						}
					>
						No
					</button>
				</form>
				<div class="rounded-lg border bg-card px-4 py-3">
					<p class="text-sm text-muted-foreground">Current streak</p>
					<p class="text-2xl font-semibold">
						{ fmt.Sprintf("%d", streak) }
						if streak == 1 {
							night
						} else {
							nights
						}
					</p>
				</div>
				if milestone != "" {
					<div class="rounded-lg border border-primary/40 bg-primary/10 px-4 py-3 text-sm font-medium">
						{ milestone }
					</div>
				}
			}
		}
	</div>
}
