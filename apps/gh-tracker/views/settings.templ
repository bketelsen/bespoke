package views

import (
	"fmt"

	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
)

// SettingsProject is one configured owner/repo row for the settings view.
type SettingsProject struct {
	ID        int64
	OwnerRepo string
}

templ Settings(user auth.User, projects []SettingsProject, hasToken bool, errMsg string) {
	@ui.AppShell(ui.ShellProps{Title: "GH Tracker Settings", User: user}) {
		if errMsg != "" {
			<div class="mb-4 rounded-lg border border-destructive/50 bg-destructive/10 px-4 py-2 text-sm text-destructive">
				{ errMsg }
			</div>
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					GitHub token
				}
				@card.Description() {
					Optional — raises the API rate limit and is required for private repos.
				}
			}
			@card.Content(card.ContentProps{Class: "pt-0"}) {
				<form method="post" action="/settings/token" class="flex flex-col gap-3 sm:flex-row sm:items-center">
					@input.Input(input.Props{
						Name:        "github_token",
						Type:        input.TypePassword,
						Placeholder: tokenPlaceholder(hasToken),
						Class:       "flex-1",
					})
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Save
					}
				</form>
			}
		}
		<div class="mt-6">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Tracked projects ({ fmt.Sprint(len(projects)) }/7)
					}
					@card.Description() {
						owner/repo, e.g. octocat/hello-world
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-3 pt-0"}) {
					if len(projects) < 7 {
						<form method="post" action="/settings/projects" class="flex flex-col gap-2 sm:flex-row">
							@input.Input(input.Props{
								Name:        "owner_repo",
								Placeholder: "owner/repo",
								Class:       "flex-1",
							})
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								@icon.Plus(icon.Props{Class: "size-4"})
								Add
							}
						</form>
					}
					<div class="space-y-1">
						for _, p := range projects {
							<div class="flex items-center justify-between gap-2 rounded-md border bg-card px-3 py-2">
								<span class="min-w-0 flex-1 truncate text-sm">{ p.OwnerRepo }</span>
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/settings/projects/%d/delete", p.ID)) }>
									@button.Button(button.Props{
										Type:    button.TypeSubmit,
										Variant: button.VariantGhost,
										Size:    button.SizeIcon,
										Class:   "size-8 shrink-0 text-muted-foreground",
									}) {
										@icon.Trash2(icon.Props{Class: "size-4"})
									}
								</form>
							</div>
						}
					</div>
				}
			}
		</div>
		<div class="mt-6">
			@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) {
				Back to list
			}
		</div>
	}
}

func tokenPlaceholder(hasToken bool) string {
	if hasToken {
		return "•••••••••••• (saved — leave blank to keep)"
	}
	return "ghp_..."
}
