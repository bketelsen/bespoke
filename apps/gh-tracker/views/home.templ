package views

import (
	"fmt"

	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/badge"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
)

// Item is one open PR or issue ready for rendering.
type Item struct {
	Type         string // "pr" or "issue"
	Title        string
	URL          string
	Number       int
	UpdatedLabel string // humanized, e.g. "12 min ago"
}

// ProjectGroup is one tracked repo with its open items.
type ProjectGroup struct {
	ID          int64
	OwnerRepo   string
	Items       []Item
	SyncedLabel string // humanized last_fetched_at, "" if never synced
	FetchErr    string
}

templ Home(user auth.User, groups []ProjectGroup) {
	@ui.AppShell(ui.ShellProps{Title: "GH Tracker", User: user}) {
		<div class="mb-4 flex items-center justify-end">
			@button.Button(button.Props{Href: "/settings", Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icon.Settings(icon.Props{Class: "size-4"})
				Settings
			}
		</div>
		<div data-init="@get('/_live')">
			@GroupsLive(groups)
		</div>
	}
}

// GroupsLive is the live region (ADR-0022): patched over SSE whenever the
// user's project list or cache changes.
templ GroupsLive(groups []ProjectGroup) {
	<div id="gh-tracker-live" class="space-y-4">
		if len(groups) == 0 {
			<p class="mt-4 text-muted-foreground">
				No projects configured yet.
				<a href="/settings" class="text-primary hover:underline">Add up to 7 GitHub repos</a>
				to track their open PRs and issues.
			</p>
		}
		for _, g := range groups {
			@projectCard(g)
		}
	</div>
}

templ projectCard(g ProjectGroup) {
	<div class="rounded-lg border bg-card px-4 py-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<a
				href={ templ.SafeURL("https://github.com/" + g.OwnerRepo) }
				target="_blank"
				rel="noopener noreferrer"
				class="font-medium hover:underline"
			>
				{ g.OwnerRepo }
			</a>
			if g.SyncedLabel != "" {
				<span class="text-xs text-muted-foreground">synced { g.SyncedLabel }</span>
			}
		</div>
		if g.FetchErr != "" {
			<p class="mt-1 text-xs text-destructive">refresh failed: { g.FetchErr } — showing last known items</p>
		}
		if len(g.Items) == 0 && g.FetchErr == "" {
			<p class="mt-2 text-sm text-muted-foreground">No open PRs or issues.</p>
		}
		<div class="mt-2 space-y-1.5">
			for _, it := range g.Items {
				@itemRow(it)
			}
		</div>
	</div>
}

templ itemRow(it Item) {
	<div class="flex items-center gap-2">
		if it.Type == "pr" {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "shrink-0"}) {
				@icon.GitPullRequest(icon.Props{Class: "size-3"})
				PR
			}
		} else {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0"}) {
				@icon.CircleDot(icon.Props{Class: "size-3"})
				Issue
			}
		}
		<a
			href={ templ.SafeURL(it.URL) }
			target="_blank"
			rel="noopener noreferrer"
			class="min-w-0 flex-1 truncate text-sm hover:underline"
		>
			{ fmt.Sprintf("#%d %s", it.Number, it.Title) }
		</a>
		if it.UpdatedLabel != "" {
			<span class="shrink-0 text-xs text-muted-foreground">{ it.UpdatedLabel }</span>
		}
	</div>
}
