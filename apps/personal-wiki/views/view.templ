package views

import (
	"fmt"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/badge"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
)

templ View(user auth.User, p Page, backlinks []PageSummary) {
	@ui.AppShell(ui.ShellProps{Title: p.Title, User: user}) {
		@card.Card() {
			@card.Header() {
				<div class="flex flex-wrap items-center justify-between gap-2">
					@card.Title() {
						{ p.Title }
					}
					<div class="flex shrink-0 gap-2">
						@button.Button(button.Props{Href: fmt.Sprintf("/page/%d/edit", p.ID), Variant: button.VariantOutline, Size: button.SizeSm}) {
							Edit
						}
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/page/%d/delete", p.ID)) }>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Size: button.SizeSm}) {
								Delete
							}
						</form>
					</div>
				</div>
				if len(p.Tags) > 0 {
					<div class="flex flex-wrap gap-1 pt-1">
						for _, t := range p.Tags {
							<a href={ templ.SafeURL("/tag/" + t) }>
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									{ t }
								}
							</a>
						}
					</div>
				}
			}
			@card.Content() {
				if p.RenderedBody == "" {
					<p class="text-sm text-muted-foreground">This page is empty — <a href={ templ.SafeURL(fmt.Sprintf("/page/%d/edit", p.ID)) } class="text-primary hover:underline">add content</a>.</p>
				} else {
					@ui.Markdown(p.RenderedBody)
				}
			}
			@card.Footer(card.FooterProps{Class: "flex-col items-start gap-1 text-xs text-muted-foreground"}) {
				<p>{ "Created " + p.CreatedLabel }</p>
				<p>{ "Updated " + p.UpdatedLabel }</p>
				if p.LastViewedLabel != "" {
					<p>{ "Last viewed " + p.LastViewedLabel }</p>
				}
			}
		}
		if len(backlinks) > 0 {
			<div class="mt-4">
				<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Pages that link here</p>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, b := range backlinks {
						<a href={ templ.SafeURL(fmt.Sprintf("/page/%d", b.ID)) } class="rounded-md border bg-card px-3 py-1.5 text-sm hover:bg-accent">
							{ b.Title }
						</a>
					}
				</div>
			</div>
		}
	}
}
