package views

import (
	"fmt"
	"net/url"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/badge"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
)

templ Home(user auth.User, index Page, orphans []PageSummary, pages []PageSummary, recent []PageSummary, alpha bool, q string) {
	@ui.AppShell(ui.ShellProps{Title: "Personal Wiki", User: user}) {
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			<form method="get" action="/" class="flex-1">
				@input.Input(input.Props{Name: "q", Placeholder: "search pages…", Value: q, Type: input.TypeSearch})
			</form>
			@button.Button(button.Props{Href: "/new"}) {
				New page
			}
		</div>
		if q == "" && !alpha {
			<div class="mt-6" data-init="@get('/_live')">
				@HomeLive(index, orphans, pages, recent)
			</div>
		} else {
			<div class="mt-6 flex items-center justify-between">
				<p class="text-sm text-muted-foreground">{ fmt.Sprintf("%d pages", len(pages)) }</p>
				if alpha {
					<a href={ templ.SafeURL("/?" + qparam(q, "")) } class="text-sm text-primary hover:underline">sort: recent</a>
				} else {
					<a href={ templ.SafeURL("/?sort=alpha" + qparam(q, "&")) } class="text-sm text-primary hover:underline">sort: A-Z</a>
				}
			</div>
			@pageList(pages)
		}
	}
}

// HomeLive is the home page's live region (ADR-0022), re-rendered on any
// wiki mutation: the Index (the hierarchy root), orphans, recently viewed,
// and the page list in recent order. Search and A–Z views render statically
// outside it — they carry request state the live hub doesn't have. Keep the
// id stable.
templ HomeLive(index Page, orphans []PageSummary, pages []PageSummary, recent []PageSummary) {
	<div id="wiki-live" class="space-y-6">
		@card.Card() {
			@card.Header() {
				<div class="flex items-center justify-between gap-2">
					@card.Title() {
						Index
					}
					@button.Button(button.Props{Href: fmt.Sprintf("/page/%d/edit", index.ID), Variant: button.VariantOutline, Size: button.SizeSm}) {
						Edit
					}
				</div>
			}
			@card.Content() {
				@ui.Markdown(index.RenderedBody)
			}
		}
		if len(orphans) > 0 {
			<div>
				<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Not in the hierarchy yet</p>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, p := range orphans {
						<a href={ templ.SafeURL(fmt.Sprintf("/page/%d", p.ID)) } class="rounded-md border border-dashed bg-card px-3 py-1.5 text-sm hover:bg-accent">
							{ p.Title }
						</a>
					}
				</div>
			</div>
		}
		if len(recent) > 0 {
			<div>
				<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Recently viewed</p>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, p := range recent {
						<a href={ templ.SafeURL(fmt.Sprintf("/page/%d", p.ID)) } class="rounded-md border bg-card px-3 py-1.5 text-sm hover:bg-accent">
							{ p.Title }
						</a>
					}
				</div>
			</div>
		}
		<div>
			<div class="flex items-center justify-between">
				<p class="text-sm text-muted-foreground">{ fmt.Sprintf("%d pages", len(pages)) }</p>
				<a href="/?sort=alpha" class="text-sm text-primary hover:underline">sort: A-Z</a>
			</div>
			@pageList(pages)
		</div>
	</div>
}

templ pageList(pages []PageSummary) {
	<div class="mt-2 space-y-2">
		if len(pages) == 0 {
			@card.Card() {
				@card.Content(card.ContentProps{Class: "pt-6 text-sm text-muted-foreground"}) {
					No pages yet — create the first one above.
				}
			}
		}
		for _, p := range pages {
			<a href={ templ.SafeURL(fmt.Sprintf("/page/%d", p.ID)) } class="block rounded-lg border bg-card px-4 py-3 hover:bg-accent">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<span class="min-w-0 flex-1 truncate font-medium">{ p.Title }</span>
					<span class="shrink-0 text-xs text-muted-foreground">{ p.UpdatedLabel }</span>
				</div>
				if len(p.Tags) > 0 {
					<div class="mt-1.5 flex flex-wrap gap-1">
						for _, t := range p.Tags {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								{ t }
							}
						}
					</div>
				}
			</a>
		}
	</div>
}

func qparam(q, prefix string) string {
	if q == "" {
		return ""
	}
	return prefix + "q=" + url.QueryEscape(q)
}
