package views

import (
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
	"github.com/bketelsen/bespoke/pkg/ui/components/textarea"
)

templ New(user auth.User) {
	@ui.AppShell(ui.ShellProps{Title: "Personal Wiki", User: user}) {
		<form method="post" action="/pages">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						New page
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-3"}) {
					@input.Input(input.Props{Name: "title", Placeholder: "title"})
					@textarea.Textarea(textarea.Props{Name: "body", Placeholder: "write in markdown — use [[Other Page]] to link", Rows: 10, AutoResize: true})
					@input.Input(input.Props{Name: "tags", Placeholder: "tags, comma separated"})
				}
				@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
					@button.Button(button.Props{Href: "/", Variant: button.VariantGhost}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create
					}
				}
			}
		</form>
	}
}
