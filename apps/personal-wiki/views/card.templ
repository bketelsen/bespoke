package views

import "fmt"

// DashCard: recently-viewed count + total pages + quick search link.
// Content only (ADR-0017).
templ DashCard(recentCount, total int) {
	<div class="space-y-2">
		if total == 0 {
			<p class="text-sm text-muted-foreground">No pages yet.</p>
		} else {
			<p class="text-sm">{ fmt.Sprintf("%d pages, %d viewed this week", total, recentCount) }</p>
		}
		<a href="/" class="text-sm text-primary hover:underline">Search wiki →</a>
	</div>
}
