package views

// DashCard: most recent 3-5 bookmarks, title only, tap to open (README).
// Content only (ADR-0017) — no AppShell, no LLM calls.
templ DashCard(bms []Bookmark) {
	if len(bms) == 0 {
		<p class="text-sm text-muted-foreground">No bookmarks yet.</p>
	} else {
		<ul class="space-y-1">
			for _, b := range bms {
				<li>
					<a href={ templ.SafeURL(b.URL) } target="_blank" rel="noopener noreferrer" class="block truncate text-sm text-foreground hover:underline">
						{ b.Title }
					</a>
				</li>
			}
		</ul>
	}
}
