package views

import (
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
)

templ Add(user auth.User, url, title, tags string) {
	@ui.AppShell(ui.ShellProps{Title: "Bookmarks", User: user}) {
		<form method="post" action="/add">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Add a bookmark
					}
					@card.Description() {
						Paste a URL — the title is fetched from the page automatically. Leave title blank to auto-fetch.
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-3"}) {
					@input.Input(input.Props{Name: "url", Type: input.TypeURL, Placeholder: "https://example.com", Value: url, Required: true})
					@input.Input(input.Props{Name: "title", Placeholder: "title (optional — auto-fetched if left blank)", Value: title})
					@input.Input(input.Props{Name: "tags", Placeholder: "tags, comma, separated (optional)", Value: tags})
				}
				@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
					@button.Button(button.Props{Href: "/", Variant: button.VariantGhost}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Save
					}
				}
			}
		</form>
	}
}
