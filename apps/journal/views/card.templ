package views

import "fmt"

// DashCard is the journal's dashboard card fragment (ADR-0017): today's
// activity at a glance plus the freshest entry. Content only — the
// dashboard owns the frame.
templ DashCard(todayCount int, latestTime, latestSnippet string) {
	if todayCount == 0 && latestSnippet == "" {
		<p class="text-sm text-muted-foreground">Nothing yet — write the first entry.</p>
	} else {
		<div class="space-y-2">
			<p class="text-sm">
				if todayCount == 0 {
					<span class="text-muted-foreground">No entries yet today</span>
				} else {
					{ fmt.Sprintf("%d %s today", todayCount, plural(todayCount, "entry", "entries")) }
				}
			</p>
			if latestSnippet != "" {
				<p class="text-sm text-muted-foreground">
					<span class="tabular-nums">{ latestTime }</span>
					&nbsp;·&nbsp;
					{ latestSnippet }
				</p>
			}
		</div>
	}
}

func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}
