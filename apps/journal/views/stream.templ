package views

import (
	"fmt"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
	"github.com/bketelsen/bespoke/pkg/ui/components/tabs"
	"github.com/bketelsen/bespoke/pkg/ui/components/textarea"
)

// captureFooter is the shared save row; the voice button only makes sense
// on the free-form Random tab.
templ captureFooter(voice bool) {
	<div class="flex items-center justify-between">
		<a href="/week" class="text-sm text-primary hover:underline">Weekly summary →</a>
		<div class="flex items-center gap-2">
			if voice {
				@ui.VoiceButton("/entries/voice")
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Save
			}
		</div>
	</div>
}

type Entry struct {
	ID   int64
	Time string // local HH:MM
	Body string
}

type Day struct {
	Label   string // Today / Yesterday / Mon, Jan 2 2006
	Entries []Entry
}

type Summary struct {
	Body       string
	RangeStart string
	RangeEnd   string
	Generated  string
}

templ Stream(user auth.User, days []Day) {
	@ui.AppShell(ui.ShellProps{Title: "Journal", User: user}) {
		@card.Card() {
			@card.Content(card.ContentProps{Class: "pt-6"}) {
				@tabs.Tabs() {
					@tabs.List(tabs.ListProps{Class: "mb-4"}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "random", IsActive: true}) {
							Random
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "work"}) {
							Work Log
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "reflection"}) {
							<span class="hidden sm:inline">Evening&nbsp;</span>
							Reflection
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "random", IsActive: true}) {
						<form method="post" action="/entries" class="space-y-3">
							@textarea.Textarea(textarea.Props{
								Name:        "body",
								Placeholder: "write anything…",
								Rows:        3,
								AutoResize:  true,
							})
							@captureFooter(true)
						</form>
					}
					@tabs.Content(tabs.ContentProps{Value: "work"}) {
						<form method="post" action="/entries/work" class="space-y-3">
							@input.Input(input.Props{Name: "project", Placeholder: "project"})
							@textarea.Textarea(textarea.Props{
								Name:        "task",
								Placeholder: "what did you work on?",
								Rows:        2,
								AutoResize:  true,
							})
							@input.Input(input.Props{Name: "time", Placeholder: "time spent (e.g. 2h)"})
							@captureFooter(false)
						</form>
					}
					@tabs.Content(tabs.ContentProps{Value: "reflection"}) {
						<form method="post" action="/entries/reflection" class="space-y-3">
							@textarea.Textarea(textarea.Props{
								Name:        "general",
								Placeholder: "how was the day, generally?",
								Rows:        2,
								AutoResize:  true,
							})
							@textarea.Textarea(textarea.Props{
								Name:        "work",
								Placeholder: "and work?",
								Rows:        2,
								AutoResize:  true,
							})
							@textarea.Textarea(textarea.Props{
								Name:        "family",
								Placeholder: "and family?",
								Rows:        2,
								AutoResize:  true,
							})
							@captureFooter(false)
						</form>
					}
				}
				@tabs.Script()
			}
		}
		if len(days) == 0 {
			<p class="mt-8 text-muted-foreground">Nothing yet — first entry goes above.</p>
		}
		for _, d := range days {
			<h2 class="mt-8 mb-3 text-sm font-medium text-muted-foreground">{ d.Label }</h2>
			<div class="space-y-2">
				for _, e := range d.Entries {
					<div class="group flex gap-3 rounded-lg border bg-card px-4 py-3">
						<span class="pt-0.5 text-xs tabular-nums text-muted-foreground">{ e.Time }</span>
						<div class="min-w-0 flex-1">
							@ui.Markdown(e.Body)
						</div>
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/entries/%d/delete", e.ID)) }
							class="opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:opacity-100"
						>
							@button.Button(button.Props{
								Type:    button.TypeSubmit,
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "size-6 text-muted-foreground pointer-coarse:size-8",
							}) {
								@icon.X(icon.Props{Class: "size-3.5"})
							}
						</form>
					</div>
				}
			</div>
		}
		@textarea.Script()
	}
}
