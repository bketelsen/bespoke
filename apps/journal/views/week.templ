package views

import (
	"fmt"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
)

templ Week(user auth.User, sum *Summary, count int) {
	@ui.AppShell(ui.ShellProps{Title: "Journal", User: user}) {
		<a href="/" class="text-sm text-primary hover:underline">← Stream</a>
		<div class="mt-4">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						The last 7 days
					}
					@card.Description() {
						{ fmt.Sprintf("%d entries", count) }
					}
				}
				@card.Content() {
					if sum != nil {
						<p class="whitespace-pre-wrap">{ sum.Body }</p>
						<p class="mt-4 text-xs text-muted-foreground">
							{ sum.RangeStart } – { sum.RangeEnd } · generated { sum.Generated }
						</p>
					} else {
						<p class="text-muted-foreground">No summary yet — generate one below.</p>
					}
				}
				@card.Footer() {
					<form method="post" action="/week/summarize">
						@button.Button(button.Props{Type: button.TypeSubmit, Disabled: count == 0}) {
							if sum != nil {
								Regenerate
							} else {
								Summarize last 7 days
							}
						}
					</form>
				}
			}
		</div>
	}
}
