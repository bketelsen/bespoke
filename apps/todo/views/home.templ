package views

import (
	"context"
	"fmt"
	"net/url"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/badge"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
)

type Task struct {
	ID          int64
	Description string
	Due         string // YYYY-MM-DD or ""
	DueLabel    string // humanized
	Overdue     bool
	Priority    string // L/M/H
	Done        bool
	Subtasks    []Task
}

type CardRow struct {
	Description string
	DueLabel    string
	Overdue     bool
	Priority    string
}

templ Home(user auth.User, tasks []Task, hideCompleted bool, justDid string) {
	@ui.AppShell(ui.ShellProps{Title: "Todo", User: user}) {
		if justDid != "" {
			@doneBanner(justDid)
		}
		<form method="post" action="/tasks">
			@card.Card() {
				@card.Content(card.ContentProps{Class: "space-y-3 pt-6"}) {
					@input.Input(input.Props{Name: "description", Placeholder: "what needs doing?"})
					<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
						<div class="flex items-center gap-2">
							@input.Input(input.Props{Name: "due", Type: input.TypeDate, Class: "w-40"})
							<select name="priority" class="h-9 rounded-md border bg-transparent px-2 text-sm text-foreground">
								<option value="L" selected>Low</option>
								<option value="M">Medium</option>
								<option value="H">High</option>
							</select>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Add task
						}
					</div>
				}
			}
		</form>
		<div class="mt-6 flex items-center justify-end">
			if hideCompleted {
				<a href="/" class="text-sm text-primary hover:underline">show completed</a>
			} else {
				<a href="/?completed=hidden" class="text-sm text-primary hover:underline">hide completed</a>
			}
		</div>
		<div data-init="@get('/_live')">
			@TasksLive(tasks)
		</div>
	}
}

// TasksLive is the live region (ADR-0022): patched over SSE on any change
// to this user's tasks. Always renders the show-all view; a user in
// ?completed=hidden sees completed reappear after a live change —
// documented trade-off.
templ TasksLive(tasks []Task) {
	<div id="todo-live" class="mt-2 space-y-3">
		if len(tasks) == 0 {
			<p class="mt-4 text-muted-foreground">Nothing here — add the first task above.</p>
		}
		for _, t := range tasks {
			<div class="rounded-lg border bg-card px-4 py-3">
				@taskRow(t, false)
				<div class="ml-7 mt-1 space-y-1">
					for _, s := range t.Subtasks {
						@taskRow(s, true)
					}
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/tasks/%d/sub", t.ID)) } class="flex items-center gap-2 pt-1">
						@input.Input(input.Props{Name: "description", Placeholder: "add a subtask…", Class: "h-8 text-sm"})
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-8 shrink-0 text-muted-foreground"}) {
							@icon.Plus(icon.Props{Class: "size-4"})
						}
					</form>
				</div>
			</div>
		}
	</div>
}

// doneBanner is the event→intent idiom (ADR-0018): completing a task offers
// journaling it, via journal's declared add-entry intent from the registry.
templ doneBanner(desc string) {
	{{ journalIntent := findIntent(ctx, "journal", "add-entry") }}
	<div class="mb-4 flex flex-wrap items-center gap-2 rounded-lg border bg-card px-4 py-3">
		@icon.CircleCheckBig(icon.Props{Class: "size-4 shrink-0 text-primary"})
		<span class="min-w-0 flex-1 break-words text-sm">Completed: { desc }</span>
		if journalIntent != "" {
			<a
				href={ templ.SafeURL(journalIntent + "?text=" + url.QueryEscape("Completed: "+desc)) }
				class="shrink-0 text-sm text-primary hover:underline"
			>
				Journal it →
			</a>
		}
		<a href="/" class="shrink-0 text-sm text-muted-foreground hover:text-foreground" title="dismiss">✕</a>
	</div>
}

func findIntent(ctx context.Context, app, name string) string {
	for _, in := range ui.IntentsFrom(ctx) {
		if in.App == app && in.Name == name {
			return in.URL
		}
	}
	return ""
}

templ taskRow(t Task, sub bool) {
	<div class="group flex items-center gap-2">
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/tasks/%d/toggle", t.ID)) } class="shrink-0">
			@button.Button(button.Props{
				Type:    button.TypeSubmit,
				Variant: button.VariantGhost,
				Size:    button.SizeIcon,
				Class:   "size-7 text-muted-foreground pointer-coarse:size-8",
			}) {
				if t.Done {
					@icon.CircleCheckBig(icon.Props{Class: "size-4.5 text-primary"})
				} else {
					@icon.Circle(icon.Props{Class: "size-4.5"})
				}
			}
		</form>
		<span class={ "min-w-0 flex-1 break-words", templ.KV("text-muted-foreground line-through", t.Done), templ.KV("text-sm", sub) }>
			{ t.Description }
		</span>
		if t.DueLabel != "" && !t.Done {
			<span class={ "shrink-0 text-xs", templ.KV("text-destructive", t.Overdue), templ.KV("text-muted-foreground", !t.Overdue) }>
				{ t.DueLabel }
			</span>
		}
		if !t.Done && t.Priority == "H" {
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "shrink-0"}) {
				High
			}
		}
		if !t.Done && t.Priority == "M" {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "shrink-0"}) {
				Med
			}
		}
		<span class="flex shrink-0 items-center opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:opacity-100">
			@button.Button(button.Props{Href: fmt.Sprintf("/tasks/%d/edit", t.ID), Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-6 text-muted-foreground pointer-coarse:size-8"}) {
				@icon.Pencil(icon.Props{Class: "size-3.5"})
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/tasks/%d/delete", t.ID)) }>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-6 text-muted-foreground pointer-coarse:size-8"}) {
					@icon.X(icon.Props{Class: "size-3.5"})
				}
			</form>
		</span>
	</div>
}
