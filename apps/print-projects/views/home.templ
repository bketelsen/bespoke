package views

import (
	"fmt"
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui"
	"github.com/bketelsen/bespoke/pkg/ui/components/badge"
	"github.com/bketelsen/bespoke/pkg/ui/components/button"
	"github.com/bketelsen/bespoke/pkg/ui/components/card"
	"github.com/bketelsen/bespoke/pkg/ui/components/dialog"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
	"github.com/bketelsen/bespoke/pkg/ui/components/input"
	"github.com/bketelsen/bespoke/pkg/ui/components/label"
	"github.com/bketelsen/bespoke/pkg/ui/components/textarea"
)

type Print struct { ID int64; PrintedOn, Notes string; HasImage bool }
type Project struct { ID int64; Name, SourceURL, Notes string; PrintCount int; Prints []Print }

templ Home(user auth.User, projects []Project, today string) {
	@ui.AppShell(ui.ShellProps{Title: "Print Projects", User: user}) {
		@card.Card() {
			@card.Header() {
				@card.Title() { Add a project }
				@card.Description() { Projects without print history stay in your want-to-print queue. }
			}
			@card.Content() {
				<form method="post" action="/projects" class="space-y-4">
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="space-y-2"><label for="name" class="text-sm font-medium">Project name</label>@input.Input(input.Props{ID:"name",Name:"name",Placeholder:"Modular Filament Spool Holder LIGHT",Required:true})</div>
						<div class="space-y-2"><label for="source_url" class="text-sm font-medium">STL, STEP, or website URL</label>@input.Input(input.Props{ID:"source_url",Name:"source_url",Type:input.TypeURL,Placeholder:"https://…"})</div>
					</div>
					<div class="space-y-2"><label for="notes" class="text-sm font-medium">Notes</label>@textarea.Textarea(textarea.Props{ID:"notes",Name:"notes",Placeholder:"Material, scale, slicer ideas…",Rows:3})</div>
					<div class="flex justify-end">@button.Button(button.Props{Type:button.TypeSubmit}) { Add project }</div>
				</form>
			}
		}
		<div data-init="@get('/_live')">@ProjectsLive(projects, today)</div>
		@dialog.Script()
	}
}

	templ ProjectsLive(projects []Project, today string) {
	<div id="print-projects-live" class="mt-6 space-y-4">
		if len(projects) == 0 {
			<p class="py-8 text-center text-sm text-muted-foreground">No projects yet — add something you want to print.</p>
		}
		for _, p := range projects {
			@projectCard(p, today)
		}
	</div>
}

templ projectCard(p Project, today string) {
	@card.Card() {
		@card.Header() {
			<div class="flex items-start gap-3">
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-2">
						@card.Title() { <span class="break-words">{ p.Name }</span> }
						if p.PrintCount == 0 {
							@badge.Badge(badge.Props{Variant:badge.VariantSecondary}) { Want to print }
						} else {
							@badge.Badge() { { fmt.Sprintf("%d prints", p.PrintCount) } }
						}
					</div>
					if p.SourceURL != "" {
						<a href={ templ.SafeURL(p.SourceURL) } target="_blank" rel="noreferrer" class="mt-2 inline-flex max-w-full items-center gap-1 text-sm text-primary hover:underline"><span class="truncate">Open source</span>@icon.ExternalLink(icon.Props{Class:"size-3.5 shrink-0"})</a>
					}
				</div>
				<div class="flex shrink-0 items-center gap-1">
					@editProjectDialog(p)
					@addPrintDialog(p, today)
				</div>
			</div>
		}
		@card.Content(card.ContentProps{Class:"space-y-4"}) {
			if p.Notes != "" {
				<div class="text-sm">@ui.Markdown(p.Notes)</div>
			}
			if len(p.Prints) > 0 {
				<div class="space-y-2"><p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Print history</p>
					for _, h := range p.Prints {
						<div class="flex gap-3 rounded-md border p-3">
							<div class="min-w-0 flex-1"><p class="text-sm font-medium">{ h.PrintedOn }</p>
								if h.Notes != "" {
									<div class="mt-1 text-sm text-muted-foreground">@ui.Markdown(h.Notes)</div>
								}
							</div>
							if h.HasImage {
								<a href={ templ.SafeURL(fmt.Sprintf("/prints/%d/image", h.ID)) } target="_blank" class="shrink-0"><img src={ templ.SafeURL(fmt.Sprintf("/prints/%d/image", h.ID)) } alt="Print result" class="size-20 rounded-md border object-cover sm:size-24"/></a>
							}
						</div>
					}
				</div>
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/projects/%d/delete", p.ID)) } class="flex justify-end">@button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantGhost,Size:button.SizeSm,Class:"text-muted-foreground"}) { @icon.Trash2(icon.Props{Class:"mr-1 size-4"}) Delete project }</form>
		}
	}
}

templ editProjectDialog(p Project) {
	@dialog.Dialog(dialog.Props{ID:fmt.Sprintf("edit-%d", p.ID)}) {
		@dialog.Trigger() { @button.Button(button.Props{Variant:button.VariantGhost,Size:button.SizeIcon,Class:"pointer-coarse:size-10"}) { @icon.Pencil(icon.Props{Class:"size-4"})<span class="sr-only">Edit project</span> } }
		@dialog.Content(dialog.ContentProps{Class:"max-h-[calc(100dvh-2rem)] overflow-y-auto"}) {
			@dialog.Header() { @dialog.Title() { Edit project } }
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/projects/%d/edit", p.ID)) } class="space-y-4">
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("edit-name-%d", p.ID)}) { Project name }@input.Input(input.Props{ID:fmt.Sprintf("edit-name-%d", p.ID),Name:"name",Value:p.Name,Required:true})</div>
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("edit-url-%d", p.ID)}) { STL, STEP, or website URL }@input.Input(input.Props{ID:fmt.Sprintf("edit-url-%d", p.ID),Name:"source_url",Type:input.TypeURL,Value:p.SourceURL})</div>
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("edit-notes-%d", p.ID)}) { Notes }@textarea.Textarea(textarea.Props{ID:fmt.Sprintf("edit-notes-%d", p.ID),Name:"notes",Value:p.Notes,Rows:4})</div>
				@dialog.Footer() { @dialog.Close() { @button.Button(button.Props{Type:button.TypeButton,Variant:button.VariantOutline}) { Cancel } } @button.Button(button.Props{Type:button.TypeSubmit}) { Save changes } }
			</form>
		}
	}
}

templ addPrintDialog(p Project, today string) {
		@dialog.Dialog(dialog.Props{ID:fmt.Sprintf("print-%d", p.ID)}) {
		@dialog.Trigger() { @button.Button(button.Props{Variant:button.VariantOutline,Size:button.SizeSm,Class:"shrink-0 pointer-coarse:min-h-10"}) { @icon.Plus(icon.Props{Class:"mr-1 size-4"}) Add print } }
		@dialog.Content(dialog.ContentProps{Class:"max-h-[calc(100dvh-2rem)] overflow-y-auto"}) {
			@dialog.Header() { @dialog.Title() { Add print } @dialog.Description() { { p.Name } } }
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/projects/%d/prints", p.ID)) } enctype="multipart/form-data" class="space-y-4">
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("printed-on-%d", p.ID)}) { Print date }@input.Input(input.Props{ID:fmt.Sprintf("printed-on-%d", p.ID),Name:"printed_on",Type:input.TypeDate,Value:today,Required:true})</div>
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("print-notes-%d", p.ID)}) { Notes }@textarea.Textarea(textarea.Props{ID:fmt.Sprintf("print-notes-%d", p.ID),Name:"notes",Placeholder:"Material, settings, outcome…",Rows:4})</div>
				<div class="space-y-2">@label.Label(label.Props{For:fmt.Sprintf("print-image-%d", p.ID)}) { Photo (optional) }@input.Input(input.Props{ID:fmt.Sprintf("print-image-%d", p.ID),Name:"image",Type:input.TypeFile,FileAccept:"image/jpeg,image/png,image/webp,image/gif"})<p class="text-xs text-muted-foreground">JPEG, PNG, WebP, or GIF up to 8 MiB.</p></div>
				@dialog.Footer() { @dialog.Close() { @button.Button(button.Props{Type:button.TypeButton,Variant:button.VariantOutline}) { Cancel } } @button.Button(button.Props{Type:button.TypeSubmit}) { Save print } }
			</form>
		}
	}
}
