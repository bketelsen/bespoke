// Bespoke wrapper components (ADR-0010): every app page lives inside
// AppShell — it owns the document, theme, header, and scripts. Apps compose
// vendored components inside it and never write CSS (CLAUDE.md).
package ui

import "github.com/bketelsen/bespoke/pkg/auth"

type ShellProps struct {
	// Title is the app's display name; empty for the dashboard itself.
	Title string
	User  auth.User
}

templ AppShell(p ShellProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if p.Title != "" {
				<title>{ p.Title } · Bespoke</title>
			} else {
				<title>Bespoke</title>
			}
			<link rel="stylesheet" href="/_bespoke/styles.css"/>
			// Set .dark before first paint; templUI themes key off the class.
			<script>if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark')</script>
			<script type="module" src="/_bespoke/js/datastar.js"></script>
		</head>
		<body class="min-h-full bg-background text-foreground antialiased">
			<header class="border-b">
				<div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
					<nav class="flex items-baseline gap-2">
						<a href={ homeURL() } class="font-semibold tracking-tight text-primary">Bespoke</a>
						if p.Title != "" {
							<span class="text-muted-foreground">/</span>
							<span class="font-medium">{ p.Title }</span>
						}
					</nav>
					<span class="text-sm text-muted-foreground">{ p.User.Name }</span>
				</div>
			</header>
			<main class="mx-auto max-w-3xl px-4 py-8">
				{ children... }
			</main>
		</body>
	</html>
}
