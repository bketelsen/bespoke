// Bespoke wrapper components (ADR-0010, ADR-0015): every app page lives
// inside AppShell — it owns the document, theme, platform chrome (app
// switcher, chat), and scripts. Apps compose vendored components inside it
// and never write CSS (AGENTS.md).
package ui

import (
	"github.com/bketelsen/bespoke/pkg/auth"
	"github.com/bketelsen/bespoke/pkg/ui/components/icon"
)

type ShellProps struct {
	// Title is the app's display name; empty for the dashboard itself.
	Title string
	User  auth.User
	// Width controls the maximum width of the shared header and page content.
	// The zero value preserves the reading-width layout used by existing apps.
	Width ShellWidth
}

// ShellWidth lets an app choose the amount of horizontal space its views may
// use without giving up AppShell's platform chrome or mobile-first behavior.
type ShellWidth string

const (
	ShellWidthReading ShellWidth = "reading"
	ShellWidthWide    ShellWidth = "wide"
	ShellWidthFull    ShellWidth = "full"
)

templ AppShell(p ShellProps) {
	{{ shell := shellDataFrom(ctx) }}
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			if p.Title != "" {
				<title>{ p.Title } · Bespoke</title>
			} else {
				<title>Bespoke</title>
			}
			<link rel="icon" href="/_bespoke/logo.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/_bespoke/styles.css"/>
			// Set .dark before first paint; templUI themes key off the class.
			<script>if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark')</script>
			<script type="module" src="/_bespoke/js/datastar.js"></script>
		</head>
		<body class="min-h-full bg-background text-foreground antialiased">
			<header class="border-b">
				<div class={ "mx-auto flex items-center justify-between px-4 py-3", shellWidthClass(p.Width) }>
					<nav class="flex items-center gap-2">
						if len(shell.Apps) > 0 {
							@appSwitcher(shell)
						}
						<div class="flex items-center gap-2">
							<a href={ shellHome(shell) } class="flex items-center gap-1.5 font-semibold tracking-tight text-primary">
								<img src="/_bespoke/logo.svg" alt="" class="size-5 shrink-0"/>
								Bespoke
							</a>
							if p.Title != "" {
								<span class="text-muted-foreground">/</span>
								<span class="font-medium">{ p.Title }</span>
							}
						</div>
					</nav>
					<div class="flex min-w-0 items-center gap-3">
						@NotificationChrome()
						if shell.ChatEnabled {
							@chatButton()
						}
						<span class="max-w-[7rem] truncate text-sm text-muted-foreground sm:max-w-none">{ p.User.Name }</span>
					</div>
				</div>
			</header>
			<main class={ "mx-auto px-4 py-8", shellWidthClass(p.Width) }>
				{ children... }
			</main>
			if shell.ChatEnabled {
				@chatPanel(p.Title)
			}
			if len(shell.Intents) > 0 {
				@intentChrome(shell.Intents)
			}
		</body>
	</html>
}

func shellWidthClass(width ShellWidth) string {
	switch width {
	case ShellWidthWide:
		return "max-w-7xl"
	case ShellWidthFull:
		return "max-w-none"
	default:
		return "max-w-3xl"
	}
}

// intentChrome ships the selection popover (ADR-0018): foreign intents as
// JSON for intents.js, plus the popover markup (classes live here so
// Tailwind scans them).
templ intentChrome(intents []IntentLink) {
	@templ.JSONScript("bespoke-intents", intentJSON(intents))
	<template id="bespoke-intent-pop-template">
		<div id="bespoke-intent-pop" class="absolute z-50 flex items-center gap-1 rounded-lg border bg-popover p-1 text-popover-foreground shadow-md">
			<template>
				<a class="rounded-md px-2.5 py-1.5 text-sm transition-colors hover:bg-muted hover:text-primary"></a>
			</template>
		</div>
	</template>
	<script type="module" src="/_bespoke/js/intents.js"></script>
}

type intentJSONEntry struct {
	Title string `json:"title"`
	URL   string `json:"url"`
}

func intentJSON(intents []IntentLink) []intentJSONEntry {
	out := make([]intentJSONEntry, 0, len(intents))
	for _, in := range intents {
		out = append(out, intentJSONEntry{Title: in.Title, URL: in.URL})
	}
	return out
}

func shellHome(d ShellData) templ.SafeURL {
	if d.HomeURL != "" {
		return templ.SafeURL(d.HomeURL)
	}
	return homeURL()
}

// appSwitcher is the Office-style waffle menu: dashboard first, then every
// registered app, current one highlighted. Native <details> — no JS.
templ appSwitcher(d ShellData) {
	<details class="relative">
		<summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground [&::-webkit-details-marker]:hidden">
			@icon.LayoutGrid(icon.Props{Class: "size-4"})
		</summary>
		<div class="absolute left-0 top-10 z-50 w-64 rounded-lg border bg-popover p-2 text-popover-foreground shadow-md">
			<a href={ shellHome(d) } class="flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted">
				@icon.House(icon.Props{Class: "size-4 text-primary"})
				<span>Dashboard</span>
			</a>
			<div class="my-1 border-t"></div>
			for _, app := range d.Apps {
				<a
					href={ templ.SafeURL(app.URL) }
					class={ "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted",
						templ.KV("bg-muted font-medium", app.Slug == d.Current) }
				>
					<span class="text-primary">
						@AppIcon(app.Icon, "size-4")
					</span>
					<span>{ app.Name }</span>
				</a>
			}
		</div>
	</details>
}
